{
  "realm": "idma",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 1800,
  "identityProviders": [
    {
      "alias": "vnpt-cas",
      "displayName": "VNPT",
      "providerId": "cas",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "casServerUrlPrefix": "https://id.vnpt.com.vn/cas",
        "gateway": "false",
        "renew": "false",
        "redirectToCasServerAfterLogout": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "idma-frontend",
      "name": "IDMA POC frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "*"],
      "webOrigins": ["http://localhost:3000", "+", "*"],
      "protocolMappers": [
        {
          "name": "trino-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "trino",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "trino-webui",
      "name": "Trino Web UI (browser OAuth2 login)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "trino-webui-secret",
      "redirectUris": [
        "https://localhost:8443/oauth2/callback",
        "https://10.165.22.31:30843/oauth2/callback"
      ],
      "webOrigins": ["https://localhost:8443", "https://10.165.22.31:30843"]
    },
    {
      "clientId": "airflow-webserver",
      "name": "Airflow (FabAuthManager OAuth login)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "airflow-webserver-secret",
      "redirectUris": [
        "http://localhost:8082/auth/oauth-authorized/keycloak",
        "http://10.165.22.31:30882/auth/oauth-authorized/keycloak"
      ],
      "webOrigins": ["http://localhost:8082", "http://10.165.22.31:30882"]
    },
    {
      "clientId": "idma-backend-admin",
      "name": "Backend's own Keycloak admin service account (Users CRUD)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "idma-backend-admin-secret"
    }
  ],
  "groups": [
    {"name": "grp_admin"},
    {"name": "grp_pm"},
    {"name": "grp_sa"},
    {"name": "grp_ds"},
    {"name": "grp_de"}
  ],
